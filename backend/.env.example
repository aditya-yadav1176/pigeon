# Server binding (0.0.0.0 enables phone/LAN testing)
HOST=0.0.0.0
PORT=8000

# Room TTL in seconds (10 minutes)
ROOM_TTL_SECONDS=600

# Max upload limit in megabytes
MAX_FILE_SIZE_MB=250

# Storage directory relative to backend/
STORAGE_DIR=storage

# CORS allowed origins (JSON array)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]
