# PIGEON Frontend Configuration

# Backend API Base URL
# For local browser testing on same computer:
VITE_API_BASE_URL=http://localhost:8000

# For Phone-to-Laptop testing on same Wi-Fi network:
# Replace with your development machine's LAN IP (run 'ipconfig' on Windows):
# VITE_API_BASE_URL=http://192.168.1.100:8000

# Transfer Service Mode:
# 'api'  -> Connect to real FastAPI backend (Default)
# 'mock' -> Offline in-memory simulation for UI testing
VITE_TRANSFER_MODE=api